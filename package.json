{
  "name": "payslip",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @payslip/web dev",
    "build": "pnpm --filter @payslip/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "contracts:build": "cd contracts && forge build && node ../scripts/export-abi.mjs",
    "chain": "anvil --port 8545 --chain-id 31337",
    "deploy:local": "tsx --env-file-if-exists=.env scripts/deploy.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @payslip/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vitest": "^5.0.5"
  }
}
