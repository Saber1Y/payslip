# Local Postgres from docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://payslip:payslip@127.0.0.1:54330/payslip

# Where RecordRegistry lives. NEXT_PUBLIC_* values are read in the browser too: the verify page reads the
# chain directly, never through Payslip's server. Defaults below are a local Anvil node (`pnpm chain`).
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Anvil (local)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=
# Base Sepolia example:
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# Relayer that pays gas for anchors, and deployer for scripts/deploy.ts. Never commit a real key.
# On Anvil you can use its first development account.
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# The passkey relying party. rpId must be the site's hostname; origin must match the browser exactly.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3020
